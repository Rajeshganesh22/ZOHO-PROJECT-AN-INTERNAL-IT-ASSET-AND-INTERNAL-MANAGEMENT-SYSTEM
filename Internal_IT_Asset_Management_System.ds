				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			employee
			(
				type = list	
				displayname = "Employee"
				values  = employee.ID
    			displayformat = [employee_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			assignment_date
			(
    			type = date
				displayname = "Assignment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			return_date
			(
    			type = date
				displayname = "Return Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			assignment_status
			(
				type = radiobuttons
				displayname = "Assignment Status"
				values = {"Assigned","Returned"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			issued_by
			(
				type = list	
				displayname = "Issued By"
				values  = employee.ID
    			displayformat = [employee_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form employee
		{
			displayname = "Employee"
			success message = "Employee Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			employee_id
			(
    			type = text
				displayname = "Employee Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			full_name
			(
    			type = name
				displayname = "Full Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Finance","HR","IT","Operations"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			role
			(
				type = picklist
				displayname = "Role"
				values = {"Administrator","Employee","Manager","IT Staff"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			active
			(
    			type = checkbox
				displayname = "Active"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			location
			(
				type = picklist
				displayname = "Location"
				values = {"Branch Office","Remote","Head Office"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			manager
			(
    			type = text
				displayname = "Manager"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department_code
			(
    			type = text
				displayname = "Department Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form it_request
		{
			displayname = "IT Request"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			request_id
			(
    			type = text
				displayname = "Request Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_type
			(
				type = picklist
				displayname = "Request Type"
				values = {"Return","Support","Asset Request","Repair"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			requested_by
			(
				type = list	
				displayname = "Requested By"
				values  = employee.ID
    			displayformat = [employee_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			related_asset
			(
				type = list	
				displayname = "Related Asset"
				values  = asset.ID
    			displayformat = [asset_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			subject_1
			(
    			type = text
				displayname = "Subject"
	 			row = 1
	 			column = 1   
				width = medium
			)
			description
			(
    			type = textarea
				displayname = "Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			priority
			(
				type = picklist
				displayname = "Priority"
				values = {"High","Low","Medium","Critical"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			submitted_date
			(
    			type = datetime
				displayname = "Submitted Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"New","Waiting for Approval","Closed","Approved","In Progress","Resolved","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_it_staff
			(
				type = list	
				displayname = "Assigned IT Staff"
				values  = employee.ID
    			displayformat = [employee_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			resolution_notes
			(
    			type = textarea
				displayname = "Resolution Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			resolved_date
			(
    			type = date
				displayname = "Resolved Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Request Submitted","Pending Manager Approval","Request Rejected","Approved","Pending IT Assignment","In Progress","Pending Resolution","Resolved","Closed"}
			}
		}
		form maintenance_record
		{
			displayname = "Maintenance Record"
			success message = "Maintenance Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			maintenance_id
			(
    			type = text
				displayname = "Maintenance Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset
			(
				type = list	
				displayname = "Asset"
				values  = asset.ID
    			displayformat = [asset_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			request_1
			(
				type = list	
				displayname = "Request"
				values  = it_request.ID
    			displayformat = [request_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
