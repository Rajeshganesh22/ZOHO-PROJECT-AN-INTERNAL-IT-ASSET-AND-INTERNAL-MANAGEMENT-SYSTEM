			)
			assigned_technician
			(
				type = list	
				displayname = "Assigned Technician"
				values  = employee.ID
    			displayformat = [employee_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Completed","In Progress","Open"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			cost
			(
				displayname = "Cost"
				type = USD
	 			row = 1
