 application "Internal IT Asset Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form asset
		{
			displayname = "Asset"
			success message = "Asset Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			asset_id
			(
    			type = text
				displayname = "Asset Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset_tag
			(
    			type = text
				displayname = "Asset Tag"
	 			row = 1
	 			column = 1   
				width = medium
			)
			asset_name
			(
    			type = text
				displayname = "Asset Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			category
			(
				type = picklist
				displayname = "Category"
				values = {"Laptop","Monitor","Accessory","Desktop","Printer","Mobile"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			manufacturer
			(
    			type = text
				displayname = "Manufacturer"
	 			row = 1
	 			column = 1   
				width = medium
			)
			model
			(
    			type = text
				displayname = "Model"
	 			row = 1
	 			column = 1   
				width = medium
			)
			serial_number
			(
    			type = text
				displayname = "Serial Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			purchase_date
			(
    			type = date
				displayname = "Purchase Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			purchase_cost
			(
				displayname = "Purchase Cost"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			warranty_end_date
			(
    			type = date
				displayname = "Warranty End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Assigned","Retired","Available","Under Maintenance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_to
			(
				type = list	
				displayname = "Assigned To"
				values  = employee.ID
    			displayformat = [employee_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			location
			(
				type = picklist
				displayname = "Location"
				values = {"Branch Office","Remote","Head Office"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form asset_assignment
		{
			displayname = "Asset Assignment"
			success message = "Asset Assignment Added Successfully"
			Section
			(
				type = section
