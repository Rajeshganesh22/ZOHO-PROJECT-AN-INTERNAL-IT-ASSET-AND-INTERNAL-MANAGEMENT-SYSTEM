				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Maintenance Request Created","Request Under Review","Request Rejected","Request Approved","Request Awaiting Parts","Technician Assigned","Request Pending Approval","Maintenance In Progress","Request Reassigned","Maintenance Completed","Maintenance On Hold","Request Reopened","Awaiting Cost Approval","Awaiting Quality Check","Maintenance Closed"}
			}
		}
	}
	reports
	{
		list it_request_Report
		{
			displayName = "IT Request Report"
			show all rows from it_request    
			(
				request_id as "Request Id"
				request_type as "Request Type"
				requested_by as "Requested By"
				related_asset as "Related Asset"
				subject_1 as "Subject"
				description as "Description"
				priority as "Priority"
				submitted_date as "Submitted Date"
				status as "Status"
				assigned_it_staff as "Assigned IT Staff"
				resolution_notes as "Resolution Notes"
				resolved_date as "Resolved Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority == "Critical")
				fields = [priority]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority == "Low")
				fields = [priority]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (priority == "Medium")
				fields = [priority]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban it_request_by_status
		{
			displayName = "Statuses"
			show all rows from it_request    
			(
				request_id as "Request Id"
				request_type as "Request Type"
				requested_by as "Requested By"
				related_asset as "Related Asset"
				subject_1 as "Subject"
				description as "Description"
				priority as "Priority"
				submitted_date as "Submitted Date"
				status as "Status"
				assigned_it_staff as "Assigned IT Staff"
				resolution_notes as "Resolution Notes"
				resolved_date as "Resolved Date"
			)
			options
			(
	 			display field = status
	 		)
		}
		list asset_assignment_Report
		{
			displayName = "All Asset Assignments"
			show all rows from asset_assignment    
			(
				assignment_id as "Assignment Id"
				asset as "Asset"
				employee as "Employee"
				assignment_date as "Assignment Date"
				return_date as "Return Date"
				assignment_status as "Assignment Status"
				issued_by as "Issued By"
				notes as "Notes"
			)
		}
		list asset_Report
		{
			displayName = "All Assets"
			show all rows from asset    
			(
				asset_id as "Asset Id"
				asset_tag as "Asset Tag"
				asset_name as "Asset Name"
				category as "Category"
				manufacturer as "Manufacturer"
				model as "Model"
				serial_number as "Serial Number"
				purchase_date as "Purchase Date"
				purchase_cost as "Purchase Cost"
				(
					display = total,average,min,max	
				)
				warranty_end_date as "Warranty End Date"
				status as "Status"
				assigned_to as "Assigned To"
				location as "Location"
				notes as "Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Assigned")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Available")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Retired")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban asset_by_category
		{
			displayName = "Categories"
			show all rows from asset    
			(
				asset_id as "Asset Id"
				asset_tag as "Asset Tag"
				asset_name as "Asset Name"
				category as "Category"
				manufacturer as "Manufacturer"
				model as "Model"
				serial_number as "Serial Number"
				purchase_date as "Purchase Date"
				purchase_cost as "Purchase Cost"
				(
					display = total,average,min,max	
				)
				warranty_end_date as "Warranty End Date"
				status as "Status"
				assigned_to as "Assigned To"
				location as "Location"
				notes as "Notes"
			)
			options
			(
	 			display field = category
	 		)
		}
		list employee_Report
		{
			displayName = "All Employees"
			show all rows from employee    
			(
				employee_id as "Employee Id"
				full_name  as "Full Name"
				department as "Department"
				email as "Email"
				role as "Role"
				active as "Active"
				location as "Location"
				phone_number as "Phone Number"
				manager as "Manager"
				department_code as "Department Code"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (department == "Finance")
				fields = [department]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (department == "HR")
				fields = [department]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (department == "Operations")
				fields = [department]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban employee_by_department
		{
			displayName = "Departments"
			show all rows from employee    
			(
				employee_id as "Employee Id"
				full_name  as "Full Name"
				department as "Department"
				email as "Email"
				role as "Role"
				active as "Active"
				location as "Location"
				phone_number as "Phone Number"
				manager as "Manager"
				department_code as "Department Code"
			)
			options
			(
	 			display field = department
	 		)
		}
		list maintenance_record_Report
		{
			displayName = "All Maintenance Records"
			show all rows from maintenance_record    
			(
				maintenance_id as "Maintenance Id"
				asset as "Asset"
				request_1 as "Request"
				reported_date as "Reported Date"
				maintenance_type as "Maintenance Type"
				description as "Description"
				assigned_technician as "Assigned Technician"
				status as "Status"
				cost as "Cost"
				(
					display = total,average,min,max	
				)
				completed_date as "Completed Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (maintenance_type == "Inspection")
				fields = [maintenance_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (maintenance_type == "Repair")
				fields = [maintenance_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (maintenance_type == "Upgrade")
				fields = [maintenance_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban maintenance_record_by_maintenance_type
		{
			displayName = "Maintenance Types"
			show all rows from maintenance_record    
			(
				maintenance_id as "Maintenance Id"
				asset as "Asset"
				request_1 as "Request"
				reported_date as "Reported Date"
				maintenance_type as "Maintenance Type"
				description as "Description"
				assigned_technician as "Assigned Technician"
				status as "Status"
				cost as "Cost"
				(
					display = total,average,min,max	
				)
				completed_date as "Completed Date"
			)
			options
			(
	 			display field = maintenance_type
	 		)
		}
	}
