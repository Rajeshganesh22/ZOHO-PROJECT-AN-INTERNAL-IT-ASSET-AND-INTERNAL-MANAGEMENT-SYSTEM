		workflow
		{
		form
		{
			notify_manager_asset_return as "Notify Manager on Asset Return"
			{
				type =  form
				form = asset_assignment

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the asset assignment record where status is 'Returned'
										assetAssignment = asset_assignment[assignment_status == "Returned" && ID == input.ID];
										// Check if the record exists
										if(assetAssignment.count() > 0)
										{
											// Get the employee who returned the asset
											employeeRecord = employee[ID == assetAssignment.employee.ID];
											// Get the manager of the employee
											managerEmail = employeeRecord.manager;
											// Check if manager email is valid
											if(!managerEmail.isNull() && !managerEmail.isEmpty())
											{
												// Get asset details
												assetRecord = asset[ID == assetAssignment.asset.ID];
												// Prepare email subject
												subject = "Asset Returned: " + assetRecord.asset_name;
												// Prepare email message
												message = "<p>Dear Manager,</p>";
												message = message.concat("<p>An asset has been returned.</p>");
												message = message.concat("<p><strong>Asset Name:</strong> " + assetRecord.asset_name + "</p>");
												message = message.concat("<p><strong>Asset Tag:</strong> " + assetRecord.asset_tag + "</p>");
												message = message.concat("<p><strong>Returned By:</strong> " + employeeRecord.full_name + "</p>");
												message = message.concat("<p><strong>Return Date:</strong> " + assetAssignment.return_date + "</p>");
												message = message.concat("<p><strong>Notes:</strong> " + assetAssignment.notes + "</p>");
												// Send email to manager
												sendmail
												[
													from :zoho.loginuserid
													to :managerEmail
													subject :subject
													message :message
													content type :HTML
												]
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			warranty_expiry_reminder as "Warranty Expiry Reminder"
			{
				type =  schedule
				form = asset
				start = warranty_end_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch assets with warranty ending in next 30 days
										warrantyExpiringAssets = asset[warranty_end_date in next 30 days];
										// Iterate through each asset and send email alert
										for each  assetRecord in warrantyExpiringAssets
										{
											// Get assigned employee email from multi_select_lookup
											assignedEmployeeEmails = List:String();
											// Check if assigned_to field has values
											if(!input.assigned_to.isNull())
											{
												// Fetch employee records from the lookup
												employeeRecords = employee[ID in input.assigned_to];
												// Collect email addresses
												for each  employee in employeeRecords
												{
													if(!employee.email.isNull())
													{
														assignedEmployeeEmails.add(employee.email);
													}
												}
											}
											// Prepare email recipients
											recipientEmails = "";
											if(assignedEmployeeEmails.size() > 0)
											{
												recipientEmails = assignedEmployeeEmails.toString(",");
											}
											else
											{
												recipientEmails = zoho.loginuserid;
											}
											// Send email notification
											sendmail
											[
												from :zoho.loginuserid
												to :recipientEmails
												subject :"Warranty Expiry Alert - " + assetRecord.asset_name
												message :"<p>Dear Team,</p><p>This is to inform you that the warranty for the following asset is expiring in 30 days:</p><p><strong>Asset Name:</strong> " + assetRecord.asset_name + "</p><p><strong>Asset Tag:</strong> " + assetRecord.asset_tag + "</p><p><strong>Warranty End Date:</strong> " + assetRecord.warranty_end_date.toString("dd MMM yyyy") + "</p><p>Please take necessary action to renew the warranty or plan for replacement.</p><p>Best Regards,<br>IT Asset Management System</p>"
											]
										}
					)
					}
				}
			}
		}


